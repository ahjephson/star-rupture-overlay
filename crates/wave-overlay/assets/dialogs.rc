#pragma code_page(65001)

101 DIALOGEX 0, 0, 320, 383
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "StarRupture Overlay"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Settings", 140, 16, 12, 285, 21
    CONTROL "", 155, "SysTabControl32", WS_TABSTOP, 16, 35, 288, 282
    GROUPBOX "Startup", 160, 16, 56, 288, 52
    CONTROL "Start with &Windows", 110, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 72, 260, 14
    LTEXT "Wait in the tray until StarRupture starts.", 161, 39, 89, 255, 12
    GROUPBOX "When the game closes", 162, 16, 119, 288, 63
    LTEXT "After a StarRupture session ends", 163, 26, 135, 264, 12
    COMBOBOX 111, 26, 152, 264, 65, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "Desktop shortcut", 164, 16, 193, 288, 64
    LTEXT "No shortcut created", 112, 26, 211, 163, 12
    PUSHBUTTON "Create shortcut", 113, 195, 205, 98, 20
    LTEXT "Starts the overlay and game through Steam. Shortcut changes apply immediately.", 165, 26, 232, 264, 22
    GROUPBOX "Countdown format", 170, 16, 268, 288, 47
    COMBOBOX 156, 26, 285, 264, 65, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Enable recipe &tracker", 150, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 72, 260, 14
    LTEXT "Pin / clear shortcut", 166, 26, 101, 94, 12
    EDITTEXT 151, 124, 98, 166, 18, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Position", 167, 26, 131, 43, 12
    COMBOBOX 152, 72, 128, 120, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Scale", 168, 202, 131, 30, 12
    COMBOBOX 153, 234, 128, 56, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Double-click recipe icons to pin or unpin", 157, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 158, 264, 14
    LTEXT "Pin up to three recipes. The shortcut toggles the hovered recipe; outside the station it clears all. Use a panel's close button to unpin it. Panels shrink beside the pause menu when space permits.", 169, 26, 182, 264, 44
    LTEXT "", 154, 26, 237, 264, 44
    LTEXT "", 114, 16, 324, 288, 26
    LTEXT "No unsaved changes", 115, 16, 361, 152, 12
    PUSHBUTTON "Cancel", IDCANCEL, 188, 356, 54, 20
    DEFPUSHBUTTON "Save", IDOK, 250, 356, 54, 20
END

102 DIALOGEX 0, 0, 320, 335
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "About StarRupture Overlay"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", 143, "Static", SS_ICON | SS_REALSIZECONTROL, 16, 16, 34, 34
    LTEXT "StarRupture Overlay", 140, 57, 13, 247, 23
    LTEXT "", 120, 57, 38, 247, 24
    CONTROL "", 142, "Static", SS_OWNERDRAW, 16, 76, 10, 15
    LTEXT "", 121, 31, 76, 273, 15, SS_CENTERIMAGE
    LTEXT "", 122, 31, 95, 273, 27
    LTEXT "Source revision", -1, 16, 132, 81, 12
    LTEXT "", 123, 102, 132, 202, 12
    LTEXT "Supported game", -1, 16, 153, 81, 12
    LTEXT "Steam · Windows x64", -1, 102, 153, 202, 12
    LTEXT "SHA256 95f95eee…8d1d76f1", -1, 102, 169, 202, 12
    LTEXT "Game location", -1, 16, 193, 81, 12
    EDITTEXT 124, 102, 190, 202, 45, ES_READONLY | ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Project", 125, 16, 245, 65, 20
    PUSHBUTTON "Report a problem", 126, 88, 245, 101, 20
    PUSHBUTTON "Licence notices", 127, 196, 245, 108, 20
    LTEXT "© 2026 Alex Jephson · PolyForm Strict 1.0.0\nAn unofficial community utility for StarRupture.", -1, 16, 276, 288, 24
    PUSHBUTTON "Copy support details", 128, 16, 309, 123, 20
    DEFPUSHBUTTON "Close", IDCANCEL, 250, 309, 54, 20
END

103 DIALOGEX 0, 0, 400, 310
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
