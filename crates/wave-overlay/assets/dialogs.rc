#pragma code_page(65001)

101 DIALOGEX 0, 0, 320, 266
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "StarRupture Overlay"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Settings", 140, 16, 12, 285, 21
    CONTROL "", 155, "SysTabControl32", WS_TABSTOP, 16, 35, 288, 202
    GROUPBOX "Startup", 160, 24, 54, 272, 36
    CONTROL "Start with &Windows", 110, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 34, 65, 252, 10
    LTEXT "Wait in the tray until StarRupture starts.", 161, 47, 78, 239, 10
    GROUPBOX "When the game closes", 162, 24, 96, 272, 36

    COMBOBOX 111, 34, 110, 252, 65, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "Desktop shortcut", 164, 24, 138, 272, 52
    LTEXT "No shortcut created", 112, 34, 151, 156, 10
    PUSHBUTTON "Create shortcut", 113, 196, 148, 90, 14
    LTEXT "Starts the overlay and game through Steam. Shortcut changes apply immediately.", 165, 34, 166, 252, 20
    CONTROL "Enable wave &timer", 180, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 54, 262, 10
    GROUPBOX "Countdown format", 170, 24, 72, 272, 38
    COMBOBOX 156, 34, 87, 252, 65, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Enable &compass", 174, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 54, 262, 10
    GROUPBOX "Waypoint arrival", 175, 24, 72, 272, 98
    CONTROL "Show arrival cue", 181, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 34, 86, 252, 10
    LTEXT "Arrive within (metres)", 182, 34, 107, 170, 10
    EDITTEXT 183, 214, 104, 72, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Clear arrival beyond (metres)", 184, 34, 127, 170, 10
    EDITTEXT 185, 214, 124, 72, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "The gap prevents the cue flickering near your destination.", 186, 34, 146, 252, 18
    CONTROL "Enable recipe &tracker", 150, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 54, 262, 10
    GROUPBOX "Pinning", 172, 24, 72, 272, 86
    LTEXT "Pin / clear shortcut", 166, 34, 85, 94, 10
    CONTROL "", 151, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 132, 83, 154, 14
    LTEXT "Click the shortcut box, then press Alt/Ctrl + a letter, top-row number or F1–F11.", 171, 34, 102, 252, 10
    CONTROL "Double-click recipe icons to pin or unpin", 157, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 34, 119, 252, 10
    LTEXT "Track up to three recipes. The shortcut toggles a hovered recipe or clears all outside the station. Close a panel with its × button.", 169, 34, 133, 252, 22
    GROUPBOX "Appearance", 173, 24, 164, 272, 34
    LTEXT "Position", 167, 34, 179, 43, 10
    COMBOBOX 152, 80, 177, 112, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Scale", 168, 194, 179, 30, 10
    COMBOBOX 153, 226, 177, 60, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", 154, 34, 204, 252, 22
    LTEXT "", 114, 16, 245, 288, 20
    PUSHBUTTON "Cancel", IDCANCEL, 197, 245, 50, 14
    DEFPUSHBUTTON "Save", IDOK, 254, 245, 50, 14
END

