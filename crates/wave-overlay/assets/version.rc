#pragma code_page(65001)
#include "overlay-version.h"

1 VERSIONINFO
FILEVERSION OVERLAY_VERSION
PRODUCTVERSION OVERLAY_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Alex Jephson\0"
            VALUE "FileDescription", "StarRupture Overlay\0"
            VALUE "FileVersion", OVERLAY_VERSION_STRING
            VALUE "InternalName", "starrupture-overlay\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Alex Jephson\0"
            VALUE "OriginalFilename", "starrupture-overlay.exe\0"
            VALUE "ProductName", "StarRupture Overlay\0"
            VALUE "ProductVersion", OVERLAY_VERSION_STRING
            VALUE "Comments", "Rupture timing and recipe research tracker for StarRupture.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
